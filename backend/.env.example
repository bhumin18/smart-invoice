# Optional environment overrides for backend/config.yaml
APP_CONFIG_PATH=config.yaml
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=5000
LOG_LEVEL=INFO

# Current working database adapter
DATABASE_ENGINE=sqlite
SQLITE_DATABASE_PATH=database/db.sqlite3

# Future production database URLs after adding a matching repository adapter:
# DATABASE_ENGINE=postgresql
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/smart_invoice
#
# DATABASE_ENGINE=mysql
# DATABASE_URL=mysql+pymysql://user:password@localhost:3306/smart_invoice
#
# DATABASE_ENGINE=mongodb
# MONGODB_URI=mongodb://localhost:27017/smart_invoice

# Optional SMTP settings for POST /api/invoices/<id>/email
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Smart Invoice
